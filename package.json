{
  "name": "with-tailwind",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "tailwindcss": "^4.1.5",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.38.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18"
  }
}
